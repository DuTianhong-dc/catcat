<mujoco model="cat3.3_robot">
<!-- FULL-COLLISION COPY (由 patches/make_cat33_fullcoll.py 生成)
     与 robot.xml 唯一区别: 碰撞 geom 的 conaffinity 换成了【floorfix 之前】
     那份完整值(自碰撞 + 地面都开)。来源: WSL 的 robot.xml.floorfix.bak
     (2026-08-27 17:37 快照)。不直接回退那份是因为它会丢掉后来的
     gaitfix / camfix / sensorfix 改动 —— 这里只取碰撞位。
     训练用的 robot.xml / scene.xml 不受影响(MJX 需要精简碰撞省显存)。
     CPU 版 MuJoCo 动态分配内存, nefc 大也没有显存问题。 -->

  <!-- ============================================================
       机器人本体(menagerie 风格,自包含,可独立加载)
       - asset: 全部 mesh(含 base_hull)
       - default: 舵机参数 class(servo)
       - worldbody: body 树 + joint + geom + site
       - actuator: 占位 motor + 12 position(class=servo)
       - contact: 碰撞排除
       独立加载: python -m mujoco.viewer robot.xml (无闭环约束)
       完整场景: scene.xml (joint equality) / scene_connect.xml (connect)
       ============================================================ -->
  <compiler angle="radian" />

  <asset>
    <mesh name="base_link_decimated" content_type="model/stl" file="meshes/base_link_decimated.STL" />
    <mesh name="Link1" content_type="model/stl" file="meshes/Link1.STL" />
    <mesh name="Link2" content_type="model/stl" file="meshes/Link2.STL" />
    <mesh name="Link3" content_type="model/stl" file="meshes/Link3.STL" />
    <mesh name="Link4" content_type="model/stl" file="meshes/Link4.STL" />
    <mesh name="Link5" content_type="model/stl" file="meshes/Link5.STL" />
    <mesh name="Link6" content_type="model/stl" file="meshes/Link6.STL" />
    <mesh name="Link7" content_type="model/stl" file="meshes/Link7.STL" />
    <mesh name="Link8" content_type="model/stl" file="meshes/Link8.STL" />
    <mesh name="Link9" content_type="model/stl" file="meshes/Link9.STL" />
    <mesh name="Link10" content_type="model/stl" file="meshes/Link10.STL" />
    <mesh name="Link11" content_type="model/stl" file="meshes/Link11.STL" />
    <mesh name="Link12" content_type="model/stl" file="meshes/Link12.STL" />
    <mesh name="Link13" content_type="model/stl" file="meshes/Link13.STL" />
    <mesh name="Link14" content_type="model/stl" file="meshes/Link14.STL" />
    <mesh name="Link15" content_type="model/stl" file="meshes/Link15.STL" />
    <mesh name="Link16" content_type="model/stl" file="meshes/Link16.STL" />
    <mesh name="Link17" content_type="model/stl" file="meshes/Link17.STL" />
    <mesh name="Link18" content_type="model/stl" file="meshes/Link18.STL" />
    <mesh name="Link19" content_type="model/stl" file="meshes/Link19.STL" />
    <mesh name="Link20" content_type="model/stl" file="meshes/Link20.STL" />
    <!-- 碰撞用凸包(2026-08-27): 原始 mesh 太稠密(52万顶点), MJX 批量碰撞按凸包顶点×环境数分配显存导致 OOM;
         外观保留原 mesh(contype=0), 碰撞换 *_hull(共约3.6千顶点)。惯量为显式 <inertial>, 动力学不变 -->
    <mesh name="Link10_hull" content_type="model/stl" file="meshes/Link10_hull.STL" />
    <mesh name="Link11_hull" content_type="model/stl" file="meshes/Link11_hull.STL" />
    <mesh name="Link12_hull" content_type="model/stl" file="meshes/Link12_hull.STL" />
    <mesh name="Link13_hull" content_type="model/stl" file="meshes/Link13_hull.STL" />
    <mesh name="Link14_hull" content_type="model/stl" file="meshes/Link14_hull.STL" />
    <mesh name="Link15_hull" content_type="model/stl" file="meshes/Link15_hull.STL" />
    <mesh name="Link16_hull" content_type="model/stl" file="meshes/Link16_hull.STL" />
    <mesh name="Link17_hull" content_type="model/stl" file="meshes/Link17_hull.STL" />
    <mesh name="Link18_hull" content_type="model/stl" file="meshes/Link18_hull.STL" />
    <mesh name="Link19_hull" content_type="model/stl" file="meshes/Link19_hull.STL" />
    <mesh name="Link1_hull" content_type="model/stl" file="meshes/Link1_hull.STL" />
    <mesh name="Link20_hull" content_type="model/stl" file="meshes/Link20_hull.STL" />
    <mesh name="Link2_hull" content_type="model/stl" file="meshes/Link2_hull.STL" />
    <mesh name="Link3_hull" content_type="model/stl" file="meshes/Link3_hull.STL" />
    <mesh name="Link4_hull" content_type="model/stl" file="meshes/Link4_hull.STL" />
    <mesh name="Link5_hull" content_type="model/stl" file="meshes/Link5_hull.STL" />
    <mesh name="Link6_hull" content_type="model/stl" file="meshes/Link6_hull.STL" />
    <mesh name="Link7_hull" content_type="model/stl" file="meshes/Link7_hull.STL" />
    <mesh name="Link8_hull" content_type="model/stl" file="meshes/Link8_hull.STL" />
    <mesh name="Link9_hull" content_type="model/stl" file="meshes/Link9_hull.STL" />
    <mesh name="base_hull" content_type="model/stl" file="meshes/base_hull.STL" />
  </asset>

  <!-- 舵机默认参数(单一事实来源):kp/kv/forcerange 集中定义,执行器只需 ctrlrange -->
  <default>
    <default class="servo">
      <position kp="100" kv="2.0" forcerange="-1.91 1.91"/>
    </default>
    <default class="servo_joint">
           <!-- 2026-08-21 社区校准: Rhoban/BAM(ICRA2025) 示波器实测 STS3215@7.4V 辨识值
           (bam/params/feetech_sts3215_7_4V/m1.json, to_mujoco 换算):
           armature=0.0284 kg·m2 / friction_base=0.0524 N·m / friction_viscous=0.0591
           替换旧值(旧: 规格书机械时间常数法 0.033 / 空载电流反推 0.125 / 估 0.05)
           说明: BAM 的 kt=1.2116 拟合偏大 -> forcerange 仍用规格堵转 1.912;
                 BAM 无 kv(反电动势折入 damping), 我们 kv=0.35 承担 -> damping 用其粘性项 0.059
           kp=100 保持(规格 PID P=32 等效区间 40~157 内, BAM kp=17.26 口径不同) -->
      <joint armature="0.0284" frictionloss="0.0524" damping="0.059"/>
    </default>
    <default class="bear6804">
      <!-- 小腿关节轴承 6804(20x32x7): 滚动摩擦 ~0.2 N·mm + 密封 ~1 N·mm ≈ 0.002 N·m -->
      <joint frictionloss="0.002" damping="0.02"/>
    </default>
    <default class="bear688">
      <!-- 连杆铰点轴承 688(8x16x5): 滚动摩擦 ~0.03 N·mm + 密封 ≈ 0.001 N·m -->
      <joint frictionloss="0.001" damping="0.02"/>
    </default>
  </default>

  <worldbody>
  <!-- ============================================================
       肢体总览(4 条腿, 每条腿 5 段 Link, 四连杆闭环):
       base_link(躯干)
       └─ Link1 (joint1=abd 髋侧摆/横摆)
          └─ Link2 (joint2=hip 髋俯仰)
             ├─ Link3 (joint3=膝=【曲柄 crank】)
             │    └─ Link4 (joint4=【连杆 coupler】, 被动)
             └─ Link5 (joint5=【摇杆+小腿/脚掌】, 被动, 触地)
       关节号规律(前进方向=+X):
       后左腿=joint1-5  后右腿=joint6-10
       前左腿=joint11-15  前右腿=joint16-20
       主动(servo)=joint1,2,3 / 6,7,8 / 11,12,13 / 16,17,18 (12个)
       被动(bear)= joint4,5 / 9,10 / 14,15 / 19,20 (8个, 四连杆)
       ============================================================ -->
    <!-- 2026-08-22: base_link 初始姿态=稳定站姿(前倾7.55°, 高度0.113) -->
    <!--   原 pos=0 -> 加载时腿深嵌地面(全零关节前腿-0.204/后腿-0.16, 地面-0.07) -> 弹起 -->
    <!--   body pos/quat 决定 freejoint 初始 qpos -> viewer 加载即稳定, 不嵌地 -->
    <body name="base_link" pos="0.0211 0.0002 0.1133" quat="0.9978 -0.0009 0.0659 -0.0003">
      <freejoint />
           <!-- inertial 从 URDF 补回（cat3.3.urdf base_link 原始值）：
           转换时丢失 → MuJoCo 按 mesh 密度1000kg/m³ 兜底算成 8.53kg，已修正为 SolidWorks 真实值 1.8064kg -->
      <inertial pos="0.013587 0.00013061 -0.0082607" quat="-0.00190685141 0.725110504 0.0106253158 0.688547909" mass="1.8064" diaginertia="0.00523771661 0.00368162211 0.00210766128" />
      <geom type="mesh" rgba="0.90 0.25 0.15 1" mesh="base_link_decimated" contype="0" conaffinity="0" group="2" />
      <!-- noselfcoll 2026-08-27: 自碰撞全关(官方四足模型做法), 只留 base+脚掌 与地面碰撞; MJX 求解器显存按 nefc^2 x 环境数 分配, 8GB 卡需要 nefc 尽量小 -->
      <geom type="mesh" name="base_hull" mesh="base_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
           <!-- 传感器安装位(2026-08-21):
           真实: IMU901 躯干中心 / VL53L0X 前缘朝前 / OV2640 前缘朝前(占位)
           虚拟: 线速度基准同 IMU 位 -->
      <site name="imu_mount" pos="0.013587 0.00013061 -0.0082607" quat="1 0 0 0" size="0.005" rgba="0 1 0 0.6" group="4"/>
      <site name="tof_mount" pos="0.19 0 0.05" quat="0.7071 0 0.7071 0" size="0.005" rgba="0 1 0 0.6" group="4"/>
      <site name="ultrasonic_mount" pos="0.19 -0.012 0.05" quat="0.7071 0 0.7071 0" size="0.005" rgba="0 1 0 0.6" group="4"/>
      <camera name="cam_front" pos="0.19 0 0.05" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      <!-- camfix 2026-08-29: 加两个"跟随"摄像机(挂在 base_link 下, 会随机体移动)。
           背景: mjx_env.render() 的 camera 参数默认值是 -1, 即 MuJoCo 默认自由
           机位 —— 它 lookat 固定、不跟随机器人, 猫一走就出画, 看起来像在
           "侧着走"。而上面那个 cam_front 虽挂在 base_link 下本该跟随, 却因
            pos 在 x=+0.19(机器人前方) 且视线朝 +x, 等于背对本体, 照不到东西。
           这两个是给 render(camera="...") 显式指定用的:
             cam_top  : 正上方俯视。画面横轴 = base x(前后), 纵轴 = base y(左右),
                        一眼可判"身体朝向"与"移动方向"是否一致
             cam_back : 正后方 -x, 略微俯视, 看步态姿态; 猫朝画面深处走
           注意: camera 不参与物理计算, 加它们对仿真零影响。 -->
      <camera name="cam_top" pos="0 0 1.1" xyaxes="1 0 0 0 1 0" fovy="55"/>
      <camera name="cam_back" pos="-0.6 0 0.4" xyaxes="0 -1 0 0.447 0 0.894" fovy="60"/>
      <!-- cam_follow: 右后方 45 度俯视, 观感最接近"原来那个默认机位"但会跟随。
           俯视(cam_top)只能靠地面格子找参照, 看步态很难受, 这个视角能同时
           看到躯干姿态 + 四条腿 + 地面参照物, 是看走路的默认选择。 -->
      <camera name="cam_follow" pos="-0.55 -0.45 0.4" xyaxes="0.634 -0.774 0 0.318 0.261 0.911" fovy="55"/>
      <!-- gaitfix 2026-08-28: 原 4 个 foot_* site 挂在躯干上(虚拟触地占位),
           现已移到四个脚掌 body 上(名字不变), 供步态奖励量脚的位置 -->
           <!-- 凸包显示 geom（诊断用，group 2 默认显示，viewer 里可直接看）：
           半透明蓝色 = base 的凸包（碰撞实际用的形状），contype=0 不参与碰撞纯显示 -->
      <!-- 后左腿根/髋(abd): 从 base_link 伸出, joint1 绕Z横摆(外展/内收) [x=-0.16=后, y=-0.06=左] -->
      <body name="Link1" pos="-0.16061 -0.062655 -0.0018124" quat="0.499998 -0.5 0.500002 -0.5">
      <inertial pos="0.00600186 0.00723091 -0.0209237" quat="0.69915 0.645052 -0.19665 0.237541" mass="0.113508" diaginertia="3.75114e-05 3.52704e-05 2.44814e-05" />
      <!-- abd 髋侧摆(髋横摆): 主动舵机(joint1) -->
      <joint name="joint1" class="servo_joint" pos="0 0 0" axis="0 0 1" range="-1.3 0.7" actuatorfrcrange="-1.91 1.91" />
      <geom type="mesh" rgba="0.95 0.70 0.10 1" mesh="Link1" contype="0" conaffinity="0" group="2" />
      <!-- floorfix 2026-08-27: MJX 静态按 nefc^2 分配求解器显存, 21 个零件全碰地时 nefc=920, 8GB 卡放不下; 只保留 base+脚掌碰地 (官方四足模型同做法) -->
      <geom type="mesh" name="Link1_hull" mesh="Link1_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
      <!-- 后左大腿(hip 髋俯仰): joint2 绕Z前后摆(俯仰), 驱动前后支撑 -->
      <body name="Link2" pos="0.029007 -0.0024191 -0.02249" quat="0.499323 -0.499325 -0.500676 0.500675">
        <inertial pos="-0.0208018 2.20259e-05 0.00215652" quat="-0.00238445 0.750456 -0.00238797 0.660912" mass="0.169369" diaginertia="0.000220786 0.000217943 3.16008e-05" />
        <!-- hip 髋俯仰: 主动舵机(joint2) -->
        <joint name="joint2" class="servo_joint" pos="0 0 0" axis="0 0 1" range="-1.2 0.52" actuatorfrcrange="-1.91 1.91" />
        <geom type="mesh" rgba="0.10 0.45 0.85 1" mesh="Link2" contype="0" conaffinity="0" group="2" />
        <!-- floorfix 2026-08-27: MJX 静态按 nefc^2 分配求解器显存, 21 个零件全碰地时 nefc=920, 8GB 卡放不下; 只保留 base+脚掌碰地 (官方四足模型同做法) -->
        <!-- noselfcoll 2026-08-27: 自碰撞全关(官方四足模型做法), 只留 base+脚掌 与地面碰撞; MJX 求解器显存按 nefc^2 x 环境数 分配, 8GB 卡需要 nefc 尽量小 -->
        <geom type="mesh" name="Link2_hull" mesh="Link2_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
        <!-- 【曲柄 crank】: joint3=驱动曲柄, 转一圈带动整条四连杆; 调腿高/支撑的关键 -->
        <body name="Link3" pos="-0.04467 0 -0.015" quat="-3.67321e-06 0 0 1">
          <inertial pos="0.013886 0.0075765 -0.0036676" quat="-0.164014 0.72486 0.184884 0.643036" mass="0.0152052" diaginertia="6.12179e-06 6.04781e-06 8.05363e-07" />
          <!-- 膝=曲柄驱动: 主动舵机(joint3) -->
          <joint name="joint3" class="servo_joint" pos="0 0 0" axis="0 0 1" range="-0.14 3" actuatorfrcrange="-1.91 1.91" />
          <geom type="mesh" rgba="0.95 0.55 0.10 1" mesh="Link3" contype="0" conaffinity="0" group="2" />
          <!-- floorfix 2026-08-27: MJX 静态按 nefc^2 分配求解器显存, 21 个零件全碰地时 nefc=920, 8GB 卡放不下; 只保留 base+脚掌碰地 (官方四足模型同做法) -->
          <!-- noselfcoll 2026-08-27: 自碰撞全关(官方四足模型做法), 只留 base+脚掌 与地面碰撞; MJX 求解器显存按 nefc^2 x 环境数 分配, 8GB 卡需要 nefc 尽量小 -->
          <geom type="mesh" name="Link3_hull" mesh="Link3_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
          <!-- 【连杆 coupler】: 四连杆中间过渡杆, 被动随动(bear688), 不触地 -->
          <body name="Link4" pos="0.045647 0.024906 -0.016" quat="0.29351 0 0 -0.955956">
            <inertial pos="0.0559857 -0.0139137 0.00158136" quat="0.0860637 0.700551 -0.0857509 0.703184" mass="0.0119298" diaginertia="2.31775e-05 2.27579e-05 5.86633e-07" />
            <joint name="joint4" class="bear688" pos="0 0 0" axis="0 0 1" />
            <geom type="mesh" rgba="0.60 0.25 0.80 1" mesh="Link4" contype="0" conaffinity="0" group="2" />
            <!-- floorfix 2026-08-27: MJX 静态按 nefc^2 分配求解器显存, 21 个零件全碰地时 nefc=920, 8GB 卡放不下; 只保留 base+脚掌碰地 (官方四足模型同做法) -->
            <geom type="mesh" name="Link4_hull" mesh="Link4_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
            <!-- 四连杆缝合点：连杆末端（坐标系4局部坐标 115.49 -28.7 8 mm） -->
            <site name="leg1_link4_connect" pos="0.11549 -0.0287 0.008" size="0.003" rgba="1 1 1 0.6" type="sphere"/>
          </body>
        </body>
        <!-- 【摇杆 rocker + 小腿/脚掌】: 四连杆输出端, 连着以下小腿+脚掌, 触地(contype=64) -->
        <body name="Link5" pos="0.075 0 -0.015">
          <inertial pos="0.015629 -0.002453 0.012602" quat="0.0680812 0.68185 -0.110723 0.719852" mass="0.054467" diaginertia="8.9638e-05 8.6472e-05 6.8518e-06" />  <!-- cat3.4: 前小腿代后小腿; 质心=网格体积加权实测, 惯量按体积比 0.9679 缩放(可用 SW 质量属性覆盖) -->
          <joint name="joint5" class="bear6804" pos="0 0 0" axis="0 0 1" />
          <geom type="mesh" rgba="0.00 0.70 0.60 1" mesh="Link5" contype="0" conaffinity="0" group="2" />
          <!-- noselfcoll 2026-08-27: 自碰撞全关(官方四足模型做法), 只留 base+脚掌 与地面碰撞; MJX 求解器显存按 nefc^2 x 环境数 分配, 8GB 卡需要 nefc 尽量小 -->
          <geom type="mesh" name="Link5_hull" mesh="Link5_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
          <!-- 四连杆缝合点：小腿上的连杆安装孔（坐标系5局部坐标 -53.62 16.14 -8 mm） -->
          <site name="leg1_link5_connect" pos="-0.05362 0.01614 -0.008" size="0.003" rgba="1 1 1 0.6" type="sphere"/>
          <site name="foot_rl" pos="0.11578 -0.04504 0.0162" size="0.005" rgba="1 1 0 0.5" group="4"/>
        </body>
      </body>
    </body>
    <!-- 后右腿根/髋(abd), 与 Link1 镜像 [x=-0.16=后, y=+0.06=右] -->
    <body name="Link6" pos="-0.16061 0.062302 -0.0015924" quat="0.499998 0.5 0.500002 0.5">
      <inertial pos="0.00607228 -0.00717897 -0.0209238" quat="0.644511 0.699797 -0.23563 0.198413" mass="0.113508" diaginertia="3.75115e-05 3.52703e-05 2.44813e-05" />
      <!-- abd 髋侧摆(后右): 主动舵机(joint6) -->
      <joint name="joint6" class="servo_joint" pos="0 0 0" axis="0 0 1" range="-0.7 1.3" actuatorfrcrange="-1.91 1.91" />
      <geom type="mesh" rgba="0.95 0.70 0.10 1" mesh="Link6" contype="0" conaffinity="0" group="2" />
      <!-- floorfix 2026-08-27: MJX 静态按 nefc^2 分配求解器显存, 21 个零件全碰地时 nefc=920, 8GB 卡放不下; 只保留 base+脚掌碰地 (官方四足模型同做法) -->
      <geom type="mesh" name="Link6_hull" mesh="Link6_hull" contype="1" conaffinity="1" group="3" rgba="0.3 0.3 0.3 0.4" />
      <!-- 后右大腿(hip), 与 Link2 镜像 -->
      <body name="Link7" pos="0.029193 0.0026998 -0.02249" quat="0.500673 0.500675 -0.499326 -0.499325">
